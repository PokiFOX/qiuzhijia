{
	// 使用 IntelliSense 了解相关属性。 
	// 悬停以查看现有属性的描述。
	// 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Launch H5",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "dev:h5",],
			"cwd": "${workspaceFolder}/vue",
			"console": "integratedTerminal",
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Launch mp-weixin",
			"runtimeExecutable": "npm",
			"runtimeArgs": [
				"run", "dev:mp-weixin",
			],
			"console": "integratedTerminal",
			"cwd": "${workspaceFolder}/vue",
			"internalConsoleOptions": "neverOpen",
		},
		{
			"name":  "config",
			"type":  "debugpy",
			"request":  "launch",
			"program": "${workspaceFolder}/config/parse.py",
			"cwd": "${workspaceFolder}/config",
		},
		{
			"name":  "backend",
			"type":  "debugpy",
			"request":  "launch",
			"module": "uvicorn",
			"args": [
				"main:app",
				"--host", "0.0.0.0",
				"--port", "22006",
				"--reload"
			],
			"cwd": "${workspaceFolder}/backend",
		},
		{
			"name": "frontend",
			"type": "dart",
			"request": "launch",
			"program": "${workspaceFolder}/frontend/lib/main.dart",
			"cwd": "${workspaceFolder}/frontend",
			"args": [
				"--web-browser-flag", "--disable-web-security",
				"--web-renderer", "html",
				"-d", "chrome", "--web-port=22000",
			],
		},
	]
}